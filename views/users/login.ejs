<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <h1 class="col-8 offset-2 mt-3">Login</h1>
        <div class="col-8 offset-2 mt-3">
            <form action="/login" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                 <label for="username" class="form-label">Username : </label>
                 <input name="username" id="username" placeholder="username" type="text" class="form-control" required>
                 <div class="invalid-feedback">Enter the validate username</div>
                </div>
                <div class="mb-3">
                 <label for="password" class="form-label">Password : </label>
                 <input name="password" id="password" placeholder="password" type="password" class="form-control" required>
                 <div class="invalid-feedback">Enter the validate password</div>
                </div>
                <button class="btn btn-success">Login</button>
            </form>
        </div>
    </div>